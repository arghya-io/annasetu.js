# Public — safe for the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — never reference in a "use client" file or expose to the browser.
# Used only inside lib/supabase/admin.ts, Route Handlers and Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY — protects /api/cron/close-day (marks missed bookings as no-shows).
# On Vercel, set CRON_SECRET and the platform sends it as `Authorization: Bearer <secret>`
# when it invokes the cron defined in vercel.json (00:00 IST daily).
CRON_SECRET=
